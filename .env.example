# --- LLM configuration -------------------------------------------------------
# The only thing the pipeline needs a model for is translation of the upstream
# notices and of the Chinese source material in content/ and docs/.
#
# Any OpenAI-compatible /chat/completions endpoint works.
OPENAI_API_KEY=<your_api_key_here>
OPENAI_BASE_URL=https://api.openai.com/v1

# Model used for translation. Cost-effective default; override if you prefer
# something else. Nothing in the dashboard itself calls a model.
TEXT_MODEL=gpt-5.6-luna
